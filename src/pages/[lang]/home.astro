---
import MainLayout from "../../layouts/MainLayout.astro";
import CarTitle from '@/assets/img/car.png';
import { generateStaticPaths } from '../../utils/i18n';
import { getDisribeList } from '../../utils/disribeList';
import { Image } from 'astro:assets';
import ImageTitle from "@/components/ImageTitle.astro";
import CarImage from "@/assets/car_2.png";
// import CarImage from "@/assets/img/seo.png";

 
import TitleVideo from "../../assets/videos/tesla.mp4"
// export async function getStaticPaths() {
//   return generateStaticPaths();
// }


export async function getStaticPaths() {
  const pageProps = {
    ukTitle: 'Тонування авто вікон Градець Кралове | DetailingCenter HK',
    csTitle: 'Tónování autoskel v Hradci Králové | DetailingCenter HK' ,
    description: {
      uk: 'Професійне затемнення та тонування вікон автомобіля у місті Градець-Кралове.',
      cs: 'Profesionální zatemnění a tónování okna aut v městě Gradec-Kralove.'
    }
  };
  
  return generateStaticPaths(pageProps);
}

const { lang } = Astro.params;
const title = Astro.props.title || 'Astro Basics';
const description = Astro.props.description || 'Astro Basics';
const translation = await import(`../../translations/${lang}.json`);

type Option = {
  image: string;
  title: string;
  description: string;
}



const disribeList = await getDisribeList(translation)
---

<MainLayout lang={lang} title={title} description={description?.[lang]}>
  <ImageTitle
    title={translation.aboutService.title}
    discription={translation.aboutService.description}
    urlImage={CarImage}
  />
  <!-- <Image 
    class="w-full max-h-[25rem] object-cover" 
    src={CarTitle} 
    alt={translation.car_image_alt || 'Car'} 
  /> -->
 
  <section class="desribe-list py-8 px-4 md:px-8">
    <h2 class="text-2xl font-bold mb-6 text-center">
      {translation.home.title}
    </h2>
    <ul class="inf-elements">
      {disribeList.map(({ Svg, title, description }) => (
        <li class="element">
          <div class="icon-wrapper">
            <Svg class="icon" />
          </div>
          <h3 class="text-lg font-semibold mt-3">{title}</h3>
          <span class="description">{description}</span>
        </li>
      ))}
    </ul>
  </section>
  <video
      src={TitleVideo}
      loop
      muted
      playsinline
      aria-label={translation.accessibility.video_result}
      class="gallery-video"
    
    />

  <!-- <section class="options  py-8 px-4 md:px-8">
    <h2 class="text-2xl font-bold mb-8 text-center">{translation.options_title}</h2>
    <ul class="options-list">
      {(translation.options as Option[]).map(({image, title, description}) => (
        <li class="option bg-white rounded-lg overflow-hidden shadow-md">
          <img 
            src={image} 
            alt="" 
            class="w-full h-48 object-cover"
          />
          <div class="option-description p-4">
            <h3 class="text-lg font-semibold mb-2">{title}</h3>
            <span class="text-gray-600">{description}</span>
          </div>
        </li>
      ))}
    </ul>
  </section> -->
</MainLayout>

<script>
  function setupVideoAutoplay() {
    const videos = document.querySelectorAll(".gallery-video");

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const video = entry.target;

        // Встановлюємо гучність один раз
        if (!video.dataset.volumeSet) {
          video.volume = 0.1; // Гучність від 0 до 1
          video.dataset.volumeSet = "true";
        }

        if (entry.isIntersecting) {
          video.play().catch(e => console.log("Error playing video", e));
        } else {
          video.pause();
        }
      });
    }, {
      threshold: 0.7 
    });

    videos.forEach(video => {
      observer.observe(video);
    });
  }

  document.addEventListener("DOMContentLoaded", setupVideoAutoplay);
  document.addEventListener("astro:after-swap", setupVideoAutoplay);
</script>

<style>
  video {
    max-width: 90%;
    width: 100%;
    margin: auto;
    height: 40rem;
    /* rotate: -90deg; */
    display: block;
  }
  .inf-elements {
    display: flex;
    width: 100%;
    max-height: 17rem;
    gap: 0.8rem;
  }

  .element {
    display: flex;
    flex-direction: column;
    /* background-color: #FFFFFF; */
    background-color: var(--color-bg-nav);
    padding: 1rem;
    flex: 1;
  }

  .icon-wrapper {
    display: flex;
    justify-content: flex-start;
  }

  .icon {
    fill: #1034A6;
    width: 2rem;
    height: 1.6rem;
  }

  .description {
    color: var(--color-text-nav);
    margin-top: 0.5rem;
  }

  .options-list {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .inf-elements {
      flex-direction: column;
      max-height: none;
    }
    
    .element {
      width: 100%;
    }
  }
</style>