---
import ThemeToggle from './ThemeToggle.astro';
import Link from './Link.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import BoxSvg from '@/assets/nav_images/box.svg';
import HomeSvg from '@/assets/nav_images/home.svg';
import ContactsSvg from '@/assets/nav_images/contacts.svg';
import WorksSvg from '@/assets/nav_images/works.svg';
import GearSvg from '@/assets/gear.svg';

const currentPath = Astro.url.pathname;
const onContactPage = /\/(kontakty|success)\/?$/.test(Astro.url.pathname);
const { lang = 'uk', currentTheme } = Astro.props;
const t = await import(`../translations/${lang}.json`).catch(() => ({}));

const navLinks = [
  { href: `/${lang}/home`, label: t.menu?.home, image: BoxSvg },
  { href: `/${lang}/services`, label: t.menu?.services, image: HomeSvg },
  // { href: `/${lang}/about`, label: t.menu?.about || 'Про нас', image: ContactsSvg },
  { href: `/${lang}/works`, label: t.menu?.works , image: WorksSvg },
  { href: `/${lang}/kontakty`, label: t.menu?.contacts, image: ContactsSvg },
];
---

<header class="header">
  <input
    type="checkbox"
    id="mobile-menu"
    class="mobile-menu-toggle"
    aria-label={t.accessibility?.menu_toggle}
  />
  <label
    for="mobile-menu"
    class="hamburger"
    tabindex="0"
    role="button"
    aria-label={t.accessibility?.menu_toggle}
    aria-pressed="false"
  >
    <span></span>
    <span></span>
    <span></span>
  </label>


  <a href="/" class="logo" aria-label={t.accessibility?.logo}>
    DetailingCenter HK
  </a>


  <div class="nav-backdrop" aria-hidden="true"></div>

  <nav class="nav" aria-label={t.accessibility?.navigation}>
    <ul class="nav-list">
      {navLinks.map((link) => (
        <li>
          <Link
            href={link.href}
            path={currentPath}
            icon={link}
            class="nav-link"
            activeClass="active"
          >
            {link.label}
          </Link>
        </li>
      ))}
    </ul>
    {!onContactPage && (
      <a href={`/${lang}/kontakty/#contact-form`} class="drawer-cta">{t.cta?.button}</a>
    )}
  </nav>


  <a
    href={`/${lang}/kontakty/#contact-form`}
    class:list={["header-cta", { "header-cta--hidden": onContactPage }]}
    aria-hidden={onContactPage ? "true" : undefined}
    tabindex={onContactPage ? -1 : undefined}
  >{t.cta?.button}</a>

  <input
    type="checkbox"
    id="mobile-actions"
    class="mobile-actions-toggle"
  />
  <label
    for="mobile-actions"
    class="mobile-actions-button"
    tabindex="0"
    role="button"
    aria-label={t.accessibility?.settings_toggle}
    aria-pressed="false"
  >
    <GearSvg class="gear-icon" />
  </label>


  <div class="actions">
    <LanguageSwitcher currentLang={lang} compact />
    <ThemeToggle translation={t.works}/>
  </div>
</header>



<script is:inline >
  
  document.addEventListener('astro:page-load', () => {
    const actionsToggle = document.getElementById('mobile-actions');
    const menuToggle = document.getElementById('mobile-menu');
    const actions = document.querySelector('.actions');
    const actionsButton = document.querySelector('.mobile-actions-button');
    const hamburger = document.querySelector('.hamburger');

    let justOpenedActions = false;
    let justOpenedMenu = false;

   
    hamburger.addEventListener('click', () => {
      justOpenedMenu = true;
      setTimeout(() => {
        justOpenedMenu = false;
      }, 100);
    });

    hamburger.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        hamburger.click();
 
      }
    });


    actionsButton.addEventListener('click', () => {
      justOpenedActions = true;
      setTimeout(() => {
        justOpenedActions = false;
      }, 100);
    });

    actionsButton.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        actionsButton.click();
      }
    });

    document.addEventListener('click', (e) => {
      if (justOpenedActions || justOpenedMenu) return;

      const clickedInsideActions = actions.contains(e.target);
      const clickedOnActionsButton = actionsButton.contains(e.target);

      const nav = document.querySelector('.nav');
      const clickedInsideNav = nav.contains(e.target);
      const clickedOnHamburger = hamburger.contains(e.target);

      if (!clickedInsideActions && !clickedOnActionsButton) {
        actionsToggle.checked = false;
      }

      if (!clickedInsideNav && !clickedOnHamburger) {
        menuToggle.checked = false;
      }
    });
  });
  
</script>



<style>
  /* :root {
    --header-bg: #1a1a1a;
    --text-color: #f8f8f8;
    --accent-color: #4f46e5;
    --mobile-breakpoint: 768px;
  } */
  .mobile-menu-toggle:focus-visible + .hamburger {
  outline: 2px solid blue;
  outline-offset: 4px;
} 
  .header {
  
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    flex-wrap: wrap;
    position: sticky;
    top: 0;
    z-index: 4;
    backface-visibility: hidden
    
    
    
  }

  /* Blur lives on a pseudo-element: backdrop-filter on .header itself would
     trap the position:fixed mobile drawer inside the header box. */
  .header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: color-mix(in srgb, var(--color-bg-nav) 85%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
  }

  .logo {
    color: var(--text-color);
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-decoration: none;
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    z-index: 1;
  }


  .mobile-menu-toggle {
    display: none;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 2.1rem;
    height: 1.5rem;
    cursor: pointer;
    
    z-index: 3;
  }

  .hamburger span {
    display: block;
    height: 2px;
    width: 100%;
   
    background-color: var(--color-text-nav);
    transition: all 0.3s ease;
  }

  .nav {
    transition: all 0.3s ease;
  }

  .nav-list {
    display: flex;
    gap: .5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    
  }

  .nav-link {
    color: var(--text-color);
    text-decoration: none;
    padding: 0.5rem;
    transition: color 0.2s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--accent-color);
  }

  .nav-backdrop, .drawer-cta { display: none; }

  .header-cta {
    padding: .6rem 1.25rem;
    border-radius: 50rem;
    color: #fff;
    font-weight: 700;
    font-size: .9rem;
    text-decoration: none;
    white-space: nowrap;
    background: var(--gradient-brand);
    background-size: 200% 100%;
    box-shadow: var(--shadow-md);
    transition: transform .2s ease, box-shadow .2s ease, background-position .6s ease;
  }
  /* keeps its space so the nav does not shift on the contact page */
  .header-cta--hidden { visibility: hidden; }

  .header-cta:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    background-position: 100% 0;
  }

  .actions {
    display: flex;
    gap: 1rem;
    align-items: center;
   
  }



   /* Стилі для шестерні та мобільних дій */
  .mobile-actions-toggle {
    display: none;
  }

  .mobile-actions-button {
    display: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 2;
    order: 3;
  }

  .gear-icon {
    width: 2rem;
    height: 2rem;
    fill: var(--text-color);
    transition: transform 0.3s ease;
  }

  



  /*Animation gear icon*/
  .mobile-actions-toggle:checked + .mobile-actions-button .gear-icon {
    transform: rotate(90deg);
  }

  .mobile-actions-toggle:checked ~ .actions {
    display: flex;
  }

  /* Мобільна версія */
  @media (max-width: 768px) {
    .actions {
      display: none;
      position: absolute;
      right: 1rem;
      top: 100%;
      background-color: var(--color-bg-geer);
      padding-right: 1rem;
      padding-left: 1rem;
      padding-bottom: 0.5rem;
      border-radius: 0.5rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
      z-index: 4;
      gap: 0.5rem;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      margin-top: 0;
  
      
    }

    
    .hamburger {
      display: flex;
    }

    .header-cta { display: none; }

    .nav {
      position: fixed;
      top: 0;
      left: 0;
      transform: translateX(-105%);
      width: min(82%, 20rem);
      height: 100dvh;
      display: flex;
      flex-direction: column;
      background: var(--color-bg-nav);
      border-right: 1px solid var(--color-border);
      border-radius: 0 1.5rem 1.5rem 0;
      padding: 5rem 1rem calc(1.5rem + env(safe-area-inset-bottom, 0px));
      z-index: 1;
      box-shadow: none;
      transition: transform .35s cubic-bezier(.2, .8, .2, 1), box-shadow .35s ease;
      overflow-y: auto;
    }

    .nav-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(2, 6, 23, .55);
      backdrop-filter: blur(3px);
      -webkit-backdrop-filter: blur(3px);
      opacity: 0;
      pointer-events: none;
      transition: opacity .3s ease;
    }

    .mobile-menu-toggle:checked ~ .nav-backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: .9rem;
      width: 100%;
    }

    .nav-list > li {
      opacity: 0;
      transform: translateX(-16px);
    }

    .mobile-menu-toggle:checked ~ .nav .nav-list > li {
      animation: drawer-item .45s cubic-bezier(.2, .8, .2, 1) forwards;
    }
    .mobile-menu-toggle:checked ~ .nav .nav-list > li:nth-child(1) { animation-delay: .08s; }
    .mobile-menu-toggle:checked ~ .nav .nav-list > li:nth-child(2) { animation-delay: .14s; }
    .mobile-menu-toggle:checked ~ .nav .nav-list > li:nth-child(3) { animation-delay: .20s; }
    .mobile-menu-toggle:checked ~ .nav .nav-list > li:nth-child(4) { animation-delay: .26s; }

    @keyframes drawer-item {
      to { opacity: 1; transform: none; }
    }

    .drawer-cta {
      display: block;
      margin-top: auto;
      padding: .95rem 1.25rem;
      border-radius: 50rem;
      text-align: center;
      font-weight: 700;
      color: #fff;
      text-decoration: none;
      background: var(--gradient-brand);
      box-shadow: 0 10px 24px -8px rgba(14, 83, 221, .7);
    }

    .mobile-menu-toggle:checked ~ .nav {
      transform: none;
      box-shadow: 0 0 48px rgba(0, 0, 0, .45);
    }

    .mobile-menu-toggle:checked + .hamburger span:nth-child(1) {
      transform: translateY(calc(0.75rem - 1px)) rotate(45deg);
    }

    .mobile-menu-toggle:checked + .hamburger span:nth-child(2) {
      opacity: 0;
    }

    .mobile-menu-toggle:checked + .hamburger span:nth-child(3) {
      transform: translateY(calc(-0.75rem + 1px)) rotate(-45deg);
    }

    .mobile-actions-button {
      display: block;
    }
    

  }
</style>