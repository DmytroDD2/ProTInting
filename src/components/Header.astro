---
import ThemeToggle from './ThemeToggle.astro';
import Link from './Link.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import BoxSvg from '@/assets/nav_images/box.svg';
import HomeSvg from '@/assets/nav_images/home.svg';
import ContactsSvg from '@/assets/nav_images/contacts.svg';
import WorksSvg from '@/assets/nav_images/works.svg';
import GearSvg from '@/assets/gear.svg';

const currentPath = Astro.url.pathname;
const { lang = 'uk', currentTheme } = Astro.props;
const t = await import(`../translations/${lang}.json`).catch(() => ({}));

const navLinks = [
  { href: `/${lang}/`, label: t.menu?.home || 'Головна', image: BoxSvg },
  { href: `/${lang}/services`, label: t.menu?.services || 'Послуги', image: HomeSvg },
  // { href: `/${lang}/about`, label: t.menu?.about || 'Про нас', image: ContactsSvg },
  { href: `/${lang}/works`, label: t.menu?.works || 'Роботи', image: WorksSvg },
  { href: `/${lang}/contacts`, label: t.menu?.contacts || 'Контакти', image: ContactsSvg },
];
---

<header class="header">
  
  

  <input type="checkbox" id="mobile-menu" class="mobile-menu-toggle" />
  <label for="mobile-menu" class="hamburger">
    <span></span>
    <span></span>
    <span></span>
  </label>
 <a href="/" class="logo">AutoTint</a>
  <nav class="nav">
    <ul class="nav-list">
      {navLinks.map((link) => (
        <li >
          {/* <link.image class="nav-link-icon"/> */}
          <Link
            href={link.href}
            path={currentPath}
            icon={link}
            class="nav-link"
            activeClass="active"
          >
            {link.label}
          </Link>
        </li>
      ))}
    </ul>
  </nav>


  <input type="checkbox" id="mobile-actions" class="mobile-actions-toggle" />
  <label for="mobile-actions" class="mobile-actions-button">
    <GearSvg class="gear-icon" />
  </label>

  <div class="actions">
    <LanguageSwitcher currentLang={lang} compact />
    <ThemeToggle  />
  </div>


  
</header>


<script is:inline >
  
  document.addEventListener('astro:page-load', () => {
    const actionsToggle = document.getElementById('mobile-actions');
    const menuToggle = document.getElementById('mobile-menu');
    const actions = document.querySelector('.actions');
    const actionsButton = document.querySelector('.mobile-actions-button');
    const hamburger = document.querySelector('.hamburger');

    let justOpenedActions = false;
    let justOpenedMenu = false;

    // Відкриття меню (гамбургера)
    hamburger.addEventListener('click', () => {
      justOpenedMenu = true;
      setTimeout(() => {
        justOpenedMenu = false;
      }, 100);
    });

    // Відкриття дій (шестерні)
    actionsButton.addEventListener('click', () => {
      justOpenedActions = true;
      setTimeout(() => {
        justOpenedActions = false;
      }, 100);
    });

    document.addEventListener('click', (e) => {
      if (justOpenedActions || justOpenedMenu) return;

      const clickedInsideActions = actions.contains(e.target);
      const clickedOnActionsButton = actionsButton.contains(e.target);

      const nav = document.querySelector('.nav');
      const clickedInsideNav = nav.contains(e.target);
      const clickedOnHamburger = hamburger.contains(e.target);

      if (!clickedInsideActions && !clickedOnActionsButton) {
        actionsToggle.checked = false;
      }

      if (!clickedInsideNav && !clickedOnHamburger) {
        menuToggle.checked = false;
      }
    });
  });
  
</script>



<style>
  /* :root {
    --header-bg: #1a1a1a;
    --text-color: #f8f8f8;
    --accent-color: #4f46e5;
    --mobile-breakpoint: 768px;
  } */

  .header {
  
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    background-color: var(--color-bg);
    position: relative;
    flex-wrap: wrap;
    position: sticky;
    top: 0;
    z-index: 4;
    backface-visibility: hidden
    
    
    
  }

  .logo {
    color: var(--text-color);
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    z-index: 1;
  }


  .mobile-menu-toggle {
    display: none;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 2.1rem;
    height: 1.5rem;
    cursor: pointer;
    
    z-index: 3;
  }

  .hamburger span {
    display: block;
    height: 2px;
    width: 100%;
   
    background-color: var(--color-text-nav);
    transition: all 0.3s ease;
  }

  .nav {
    transition: all 0.3s ease;
  }

  .nav-list {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    
  }

  .nav-link {
    color: var(--text-color);
    text-decoration: none;
    padding: 0.5rem;
    transition: color 0.2s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--accent-color);
  }

  .actions {
    display: flex;
    gap: 1rem;
    align-items: center;
   
  }



   /* Стилі для шестерні та мобільних дій */
  .mobile-actions-toggle {
    display: none;
  }

  .mobile-actions-button {
    display: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 2;
    order: 3;
  }

  .gear-icon {
    width: 2rem;
    height: 2rem;
    fill: var(--text-color);
    transition: transform 0.3s ease;
  }

  



  /*Animation gear icon*/
  .mobile-actions-toggle:checked + .mobile-actions-button .gear-icon {
    transform: rotate(90deg);
  }

  .mobile-actions-toggle:checked ~ .actions {
    display: flex;
  }

  /* Мобільна версія */
  @media (max-width: 768px) {
    .actions {
      display: none;
      position: absolute;
      right: 1rem;
      top: 100%;
      background-color: var(--color-bg-geer);
      padding-right: 1rem;
      padding-left: 1rem;
      padding-bottom: 0.5rem;
      border-radius: 0.5rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
      z-index: 4;
      gap: 0.5rem;
      flex-direction: column;
      justify-content: center;
      align-items: center;
  
      
    }

    
    .hamburger {
      
      display: flex;
    }

    .nav {
      position: fixed;
      top: 0;
      left: -100%;
      width: 45%;
      height: 100%;
      background-color: var(--header-bg);
      background-color: var( --color-bg);
      padding: 5rem 2rem 2rem;
      z-index: 1;
      transition: left 0.3s ease;
    }

    .nav-list {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
    }

    .mobile-menu-toggle:checked ~ .nav {
      left: 0;
    }

    .mobile-menu-toggle:checked + .hamburger span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }

    .mobile-menu-toggle:checked + .hamburger span:nth-child(2) {
      
    }

    .mobile-actions-button {
      display: block;
    }


  }
</style>