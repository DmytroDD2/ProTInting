---
// Floating "Contact us" button, shown on small screens on every page except the contact/success pages.
const { lang = 'cs', translation } = Astro.props;
const path = Astro.url.pathname;
const hide = /\/(kontakty|success)\/?$/.test(path);
---

{!hide && (
  <a href={`/${lang}/kontakty/#contact-form`} class="floating-cta" data-astro-prefetch>
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/>
    </svg>
    <span>{translation?.button}</span>
  </a>
)}

<style>
  .floating-cta {
    display: none;
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 20;
    align-items: center;
    gap: .5rem;
    padding: .85rem 1.25rem;
    border-radius: 50rem;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    background: var(--gradient-brand);
    box-shadow: 0 10px 28px -6px rgba(14, 83, 221, .6);
    animation: cta-pulse 2.6s ease-in-out infinite;
  }
  @keyframes cta-pulse {
    0%, 100% { box-shadow: 0 10px 28px -6px rgba(14, 83, 221, .6), 0 0 0 0 rgba(91, 142, 243, .5); }
    50% { box-shadow: 0 10px 28px -6px rgba(14, 83, 221, .6), 0 0 0 12px rgba(91, 142, 243, 0); }
  }
  @media (max-width: 768px) {
    .floating-cta { display: inline-flex; }
  }
  /* The open mobile menu has its own contact button: hide this one meanwhile */
  .floating-cta { transition: opacity .25s ease, transform .25s ease; }
  :global(body:has(#mobile-menu:checked)) .floating-cta {
    opacity: 0;
    transform: translateY(16px);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .floating-cta { animation: none; }
  }
</style>
