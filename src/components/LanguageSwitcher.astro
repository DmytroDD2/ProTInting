---
// src/components/LanguageSwitcher.astro
import { SUPPORTED_LOCALES } from '../utils/i18n';
const { currentLang = 'uk' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<div class="language-switcher" >
  <div class="dropdown" >
    <button class="dropdown-toggle" type="button" aria-label="Change language" aria-haspopup="true" aria-expanded="false">
      {currentLang === 'uk' ? '🇺🇦' : '🇨🇿'}
      <span class="chevron">▼</span>
    </button>
    <ul class="dropdown-menu" >
      {SUPPORTED_LOCALES.map((lang) => (
        <li>
          <a 
            href={currentPath.replace(`/${currentLang}`, `/${lang}`)} 
            class={currentLang === lang ? 'active' : ''}
            aria-current={currentLang === lang ? 'true' : 'false'}
          >
            {lang === 'uk' ? '🇺🇦 Українська' : '🇨🇿 Čeština'}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<script is:inline>
  function initLanguageDropdown() {
    // Drop the listeners of the previous run (this runs after every navigation)
    window.__langAbort?.abort();
    const ac = new AbortController();
    window.__langAbort = ac;
    const { signal } = ac;

    const dropdown = document.querySelector('.language-switcher .dropdown');
    if (!dropdown) return;
    const menu = dropdown.querySelector('.dropdown-menu');
    const toggle = dropdown.querySelector('.dropdown-toggle');

    const setOpen = (open) => {
      menu.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    // Tap / click opens and closes the list (hover alone does not work on phones)
    toggle.addEventListener('click', () => setOpen(!menu.classList.contains('open')), { signal });

    dropdown.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    }, { signal });

    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target)) setOpen(false);
    }, { signal });
  }

  if (!window.__langInit) {
    window.__langInit = true;
    document.addEventListener('astro:page-load', initLanguageDropdown);
  }
</script>

<style>
  .language-switcher {
    position: relative;
  }

  .dropdown-toggle {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.5rem 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s;
  }

  .dropdown-toggle:hover {
    background: rgba(0, 0, 0, 0.05);
  }


  .dark .dropdown-toggle:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .chevron {
    font-size: 0.6em;
    transition: transform 0.2s;
  }

  .dropdown-toggle[aria-expanded="true"] .chevron {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    right:0;
    background: var(--color-bg-nav);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 0.4rem;
    margin-top: 0;
    min-width: 120px;
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s;
    z-index: 100;
    box-shadow: var(--shadow-lg);
  }


  .dropdown-menu a {
    display: block;
    white-space: nowrap;
    border-radius: 0.5rem;
    padding: 0.6rem 1rem;
    text-decoration: none;
    color: var(--color-text);
    transition: background 0.2s;
  }

  .dropdown-menu a:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  .dark .dropdown-menu a:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .dropdown-menu .active {
    font-weight: bold;
    background: rgba(0, 0, 0, 0.1);
  }

  .dark .dropdown-menu .active {
    background: rgba(255, 255, 255, 0.1);
  }
  .dropdown-menu {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: all 0.2s;
}

.dropdown-menu.open {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

/* Mouse devices also open it on hover */
@media (hover: hover) and (min-width: 769px) {
  .dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .dropdown:hover .chevron { transform: rotate(180deg); }
}

/* Phone: the list opens inline inside the settings panel instead of floating over it */
@media (max-width: 768px) {
  .dropdown-toggle {
    justify-content: center;
    border-radius: 0.75rem;
    padding: 0.6rem 0.9rem;
    font-size: 1.1rem;
  }
  .dropdown-menu {
    display: none;
    position: static;
    margin-top: 0.5rem;
    min-width: 0;
    width: max-content;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    box-shadow: none;
    background: transparent;
    border-color: var(--color-border);
  }
  .dropdown-menu.open { display: block; }
}
</style>