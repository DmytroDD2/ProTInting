---
import { clsx } from 'clsx'
const { href, path, icon } = Astro.props


const isActive = (currentPath, linkPath) => {
 
  const normalize = p => new URL(p, 'http://example.com').pathname.replace(/\/+$/, '').toLowerCase()
  return normalize(currentPath) === normalize(linkPath)
}
---

<li>
  <a
    href={href}
    class={clsx("button", isActive(path, href) && 'active')}
  >
    <icon.image class={clsx("icon", isActive(path, href) && 'active')} />
    <slot />
  </a>
</li>






<style>
  .icon{
    display: none;
    width: 2rem;
    /* fill: #333; */
    fill: var(--color-text-nav);
  
    
  }


  li{}
  .active{
    fill: var(--color-text-active-nav);
  }
  a {
    display: inline-block;
    padding: 8px 16px;
    margin: 4px 0;
    text-decoration: none;
    /* color: #333; */
    color: var(--color-text);
    font-weight: 600;
    border-radius: 999px;
    transition: background-color 0.25s ease, color 0.25s ease;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;
  }
  a.active {
    /* background-color: #007bff; */
    /* color: white; */
    
    color: #0B2C8F;
    color: var(--color-text-active-nav);

    /* box-shadow: 0 4px 10px rgba(0,123,255,0.6); */
  }
  a:hover {
    background-color: var(--color-hover);
  }
  a.active {
    background-color: color-mix(in srgb, var(--color-primary) 12%, transparent);
  }

  a:active {
    color: #e0e0e0;
  }
   
  @media (max-width: 768px) {
    .icon {
      display: inline;
      flex-shrink: 0;
      width: 1.6rem;
      height: 1.6rem;
    }
    a {
      width: 100%;
      justify-content: flex-start;
      gap: 1rem;
      margin: 0;
      padding: 1rem 1.2rem;
      border-radius: 1rem;
      font-size: 1.05rem;
    }
    a.active {
      color: #fff;
      background: var(--gradient-brand);
      box-shadow: 0 8px 20px -8px rgba(14, 83, 221, .7);
    }
    a.active .icon, .icon.active {
      fill: #fff;
    }
  }
 
</style>

