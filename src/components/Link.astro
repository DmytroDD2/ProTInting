---

import {clsx} from 'clsx'
const { href, path, icon } = Astro.props;
---

 <li >
    
   
    <a

     href={href}
      class={clsx("button",
        path.endsWith(href)? 'active' 
        : 'inactive') }
    >
      <icon.image class={clsx("icon", path.endsWith(href)? 'active' : 'inactive')}/>
      <slot />
    </a>
</li>
 <!-- this maybe not need -->
<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const links = document.querySelectorAll('.nav-link');
    const currentPath = window.location.pathname;

    links.forEach(link => {
      const href = link.getAttribute('data-href');
      if (href === currentPath) {
        link.classList.add('active');
      } else {
        link.classList.remove('active');
      }
    });

    // ... твій інший код для меню
  });
</script>




<style>
  .icon{
    display: none;
    width: 2rem;
    /* fill: #333; */
    fill: var(--color-text-nav);
  
    
  }


  li{}
  .active{
    fill: #0B2C8F;
  }
  a {
    display: inline-block;
    padding: 8px 16px;
    margin: 4px 0;
    text-decoration: none;
    /* color: #333; */
    color: var(--color-text);
    font-weight: 600;
    border-radius: 6px;
    transition: background-color 0.3s ease, color 0.3s ease;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;
  }
  a.active {
    /* background-color: #007bff; */
    /* color: white; */
    
    color: #0B2C8F;
    color: var(--color-text-active-nav);

    /* box-shadow: 0 4px 10px rgba(0,123,255,0.6); */
  }
  /* a:hover {
    background-color: #e0e0e0;
  } */

  a:active {
    color: #e0e0e0;
  }
   
  @media (max-width: 768px) {
    .icon {
      display: inline;
    }
	}
 
</style>

