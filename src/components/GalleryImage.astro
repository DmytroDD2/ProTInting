---
// src/components/GalleryImage.astro
import { Image } from "astro:assets";

const { before, after, translation } = Astro.props;
---

<div class="comparison-slider"  role="button">
  <div class="before">
    <Image src={before} alt={translation.window_before} tabindex="0" class="gallery-image" loading="lazy" />
  </div>
  <div class="after">
    <Image src={after} alt={translation.window_after} tabindex="0" class="gallery-image" loading="lazy" />
  </div>

  
  <div class="label label-before">{translation.after}</div>
  <div class="label label-after">{translation.before}</div>

  <div class="slider-handle">↔</div>
</div>

<div id="lightbox" class="lightbox" onclick="closeLightbox()" > 

  <img id="lightbox-img" class="lightbox-content" alt={translation.full_image}>
  <div class="lightbox-caption"></div>
</div>


<script is:inline>


   // lightbox
  function openLightbox(src, alt) {
    
    const lightbox = document.getElementById('lightbox');
  
    if(lightbox.style.display === 'flex') {
      
      lightbox.style.display = 'none';
      return
    }else{
      
      document.getElementById('lightbox-img').src = src;
      document.querySelector('.lightbox-caption').textContent = alt;
      
      lightbox.style.display = 'flex';
    }
    


  }
  function closeLightbox() {
    document.getElementById('lightbox').style.display = 'none';
  }

  // Fix: Only open lightbox if

  document.addEventListener('click', (e) => {
     e.stopPropagation();
    const img = e.target.closest('.gallery-image');
    if (!img) return;
    openLightbox(img.src, img.alt);
  });

  // Open lightbox with Enter key when .gallery-image is focused
  document.addEventListener('keydown', (e) => {
    e.stopPropagation();
    if (
      (e.key === 'Enter' || e.key === ' ')
      
    ) {
      const img = e.target.closest('.gallery-image');
      if (!img) return;
      openLightbox(document.activeElement.src, document.activeElement.alt);
    }
    

  });


  
  // document.querySelector('.slider-handle').addEventListener('mousedown', function(e) {
  //   document.addEventListener('mousemove', slideMove);
  //   document.addEventListener('mouseup', stopSlide);
  // });
  
  // function slideMove(e) {
  //   const slider = this.closest('.comparison-slider');
  //   const after = slider.querySelector('.after');
  //   const percent = (e.clientX - slider.getBoundingClientRect().left) / slider.offsetWidth;
  //   after.style.width = (1 - percent) * 100 + '%';
  // }
  
  // function stopSlide() {
  //   document.removeEventListener('mousemove', slideMove);
  // }
</script>
<style>
  .comparison-slider {
    position: relative;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    min-width: 0;
    aspect-ratio: 16/9;
  }
  
  .before, .after {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
  }
  
  .after {
    width: 50%; /* Початкова позиція */
  }
  
  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .slider-handle {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 4px;
    background: white;
    cursor: ew-resize;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    transform: translateX(-50%);
  }
  
  .label {
  position: absolute;
  padding: 8px 15px;
  background: rgba(0,0,0,0.7);
  color: white;
  border-radius: 4px;
  
  pointer-events: none;
}

.label-before {
  left: 10px;
  bottom: 10px;
}

.label-after {
  right: 10px;
  bottom: 10px;
}


  /* Стилі для лайтбоксу */
  .lightbox {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.9);
    justify-content: center;
    align-items: center;
    justify-content: center;
    align-items: start;
  }

  .lightbox-content {
    margin-top: 3rem;
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
  }

  .close-btn {
    position: absolute;
    top: 20px;
    right: 30px;
    color: white;
    font-size: 40px;
    cursor: pointer;
  }

  .lightbox-caption {
    position: absolute;
    right: 0;
    bottom: 20px;
    color: white;
    text-align: center;
    width: 100%;
    padding: 10px;
  }
</style>

