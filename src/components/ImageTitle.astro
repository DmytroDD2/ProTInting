---
// src/components/ContactHero.astro
import { Image } from 'astro:assets';
const { urlImage, title, discription } = Astro.props;
---

<div class="relative overflow-hidden rounded-2xl shadow-lg">
  <!-- Оптимізоване фонове зображення -->
  <Image
    src={urlImage}
    alt={title}
    class="absolute inset-0 object-cover w-full h-full"
    sizes="100vw"
    loading="lazy"

  />

  <div style="background: linear-gradient(90deg, rgba(15,23,42,.88) 0%, rgba(30,64,175,.55) 55%, rgba(30,64,175,0) 100%);"
    class="relative flex flex-col max-w-[40rem] max-sm:max-w-full justify-center items-start p1-2  max-sm:py-16 min-h-[26rem] max-sm:min-h-[18rem] "
  >
    <div class="container mx-5 ">
      <h1 class="text-4xl font-extrabold text-white max-sm:text-2xl mb-3 max-w-2xl tracking-tight">
        {title}
      </h1>
      <p class="text-base text-slate-100 max-sm:text-sm max-w-xl leading-relaxed">
        {discription}
      </p>
    </div>
  </div>
</div>
