---
// src/components/ContactHero.astro
import { Image } from 'astro:assets';
const { urlImage, title, discription } = Astro.props;
---

<div class="relative overflow-hidden">
  <!-- Оптимізоване фонове зображення -->
  <Image
    src={urlImage}
    alt={title}
    class="absolute inset-0 object-cover w-full h-full"
    sizes="100vw"
    loading="lazy"

  />

  <div style="background: linear-gradient(to  right, #304da0, rgba(30,58,138,0));"
    class="relative flex flex-col max-w-[25rem] max-sm:max-w-[15rem] justify-center items-start p1-2  max-sm:py-16 min-h-[21rem] max-sm:min-h-[15rem] "
  >
    <div class="container mx-5 ">
      <h1 class="text-3xl font-bold text-white max-sm:text-xl mb-2 max-w-2xl">
        {title}
      </h1>
      <p class="text-sm text-slate-200 max-sm:text-xs max-w-2xl">
        {discription}
      </p>
    </div>
  </div>
</div>
