---
const currentThemes = Astro.props.currentTheme || "light";
---

<label class="theme-switch" transition:persist>
  <input type="checkbox" id="themeToggle" />
  <span class="slider"></span>
</label>

<style>
  /* .sun { fill: black; }
  .moon { fill: transparent; }

  :global(.dark) .sun { fill: transparent; }
  :global(.dark) .moon { fill: white; } */
  .theme-switch {
    position: relative;
    display: inline-block;
    width: 45px;
    height: 25px;
  }

  .theme-switch input {
    opacity: 0;
    width: 0;
    height: 0;
    
  }

  .slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: #ccc;
    transition: 0.6s;
    border-radius: 28px;
  }

  .slider:before {
    position: absolute;
    content: "";
    height: 17px; width: 17px;
    left: 4px;
    bottom: 4px;
    background-color: white;
    transition: 0.4s;
    border-radius: 50%;
    background-image: url("/src/assets/sun.svg");
    background-repeat: no-repeat;
    background-position: center;
    background-size: 15px 15px;
  }

  input:checked + .slider {
    background-color: #4f46e5; /* indigo-600 */
  }

  input:checked + .slider:before {
    transform: translateX(22px);
    background-image: url("/src/assets/moon.svg");
    }
</style>

<script is:inline>
  const getPreferredTheme = () => {
    const stored = localStorage.getItem("theme");
    if (stored === "light" || stored === "dark") return stored;
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  };

  const applyTheme = (theme) => {
    document.documentElement.classList.toggle('dark', theme === 'dark');
    localStorage.setItem('theme', theme);
  };

  const themeToggle = document.getElementById("themeToggle");

  // Set initial state
  const currentTheme = getPreferredTheme();
  applyTheme(currentTheme);
  if (themeToggle) {
    themeToggle.checked = currentTheme === "dark";
  }

  // Handle toggle
  themeToggle?.addEventListener("change", () => {
    const newTheme = themeToggle.checked ? "dark" : "light";
    applyTheme(newTheme);
  });

  // Reapply after Astro navigation
  document.addEventListener("astro:after-swap", () => {
    const savedTheme = localStorage.getItem("theme") || "light";
    applyTheme(savedTheme);
  });
</script>
